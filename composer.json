{
    "name": "supportflow/helpdesk",
    "description": "A production-minded helpdesk ticket management system.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0775, true);\"",
            "@php -r \"is_dir('storage/cache') || mkdir('storage/cache', 0775, true);\""
        ]
    }
}
